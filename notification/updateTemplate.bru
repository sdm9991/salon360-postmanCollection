meta {
  name: updateTemplate
  type: http
  seq: 21
}

patch {
  url: {{ip}}/notification/channel/update
  body: json
  auth: none
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
   {
          "id": 3,
          "title": "Test SMS for OTP",
          "body": "{{otp_value}}",
          "channelId": 1,
          "status": "ACTIVE",
          "externalTemplateId": null,
          "category": "OTP"
      }
}

settings {
  encodeUrl: true
}
