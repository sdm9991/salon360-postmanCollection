meta {
  name: v2/createAppointment
  type: http
  seq: 1
}

post {
  url: {{ip}}/sales/v2/createAppointment
  body: json
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
  {
      "customerId": 123,
      "appointmentStatus": "CONFIRMED",
      "appointmentDate": "2026-02-10",
      "startDate": "2026-02-10",
      "endDate": "2026-03-10",
      "recurringFrequencyJson": "{\"frequency\":\"WEEKLY\",\"daysOfWeek\":[1,3,5],\"interval\":1}",
      "appointmentNotes": "Weekly recurring",
      "sourceId": 1289,
      "appointmentDetailVOList": [
          {
              "offeringId": 456,
              "offeringType": "SERVICE",
              "offeringSku": "789",
              "startTime": "10:00:00",
              "endTime": "11:00:00",
              "roomId": 10,
              "appointmentStaffDetailVOList": [
                  {
                      "staffId": 789,
                      "requestedStaffId": 789
                  }
              ]
          }
      ]
  }
}

settings {
  encodeUrl: true
}
