meta {
  name: {{ip}}/auth/config
  type: http
  seq: 4
}

get {
  url: {{ip}}/auth/config?refresh=true
  body: json
  auth: inherit
}

params:query {
  refresh: true
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

settings {
  encodeUrl: true
}
