meta {
  name: whatsapp-baileys/message/send-text
  type: http
  seq: 2
}

post {
  url: {{ip}}/whatsapp-baileys/message/send-text
  body: json
  auth: none
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
}

body:json {
  {
      "sessionId":"test12345",
      "to":"918697234552",
      "message":"Hello world"
  }
}

settings {
  encodeUrl: true
}
