meta {
  name: getPayroll
  type: http
  seq: 1
}

get {
  url: {{ip}}/profile/payroll/getPayroll?empId=223&month=AUGUST&year=2025&storeId=85
  body: json
  auth: inherit
}

params:query {
  empId: 223
  month: AUGUST
  year: 2025
  storeId: 85
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

settings {
  encodeUrl: true
}
