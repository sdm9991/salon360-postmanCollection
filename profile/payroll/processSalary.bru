meta {
  name: processSalary
  type: http
  seq: 4
}

post {
  url: {{ip}}/profile/payroll/processSalary
  body: json
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
  {
      "year": 2025,
      "month": "JANUARY",
      "empId": 110,
      "paymentModeId": 1,
      "processedSalaryAmount" : 500
  }
}

settings {
  encodeUrl: true
}
