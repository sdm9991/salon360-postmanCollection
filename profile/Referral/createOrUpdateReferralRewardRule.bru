meta {
  name: createOrUpdateReferralRewardRule
  type: http
  seq: 3
}

post {
  url: {{ip}}/profile/referral/createOrUpdateReferralRewardRule
  body: json
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
  {
    "referralProgramId": 2,
    "rewardValue": 50,
    "rewardType": "REWARD_POINTS", // WALLET_AMOUNT / REWARD_POINTS
    "rewardTo" : "REFEREE" //REFEREE ,REFERRER
  }
}

settings {
  encodeUrl: true
}
