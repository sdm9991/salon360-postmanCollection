meta {
  name: createOrUpdateEnquiry
  type: http
  seq: 1
}

post {
  url: {{ip}}/profile/enquiry/createOrUpdateEnquiry
  body: json
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
  {
      "customerId": 1241,
      "enquiryDate": "2025-09-09 10:30:00",
      "enquiryNotes": "Customer interested in premium package",
      "assignedTo": 5, // assigned to  emp  id
      "leadStatus": "NEW", //  NEW, FOLLOW_UP, CONVERTED, CANCELLED
      "enquiryType": "HOT", //HOT, WARM, COLD, NOT_INTERESTED
      "modes":"Wapp",
      // for leadstatus == FOLLOW_UP
      // "followupDate": "2025-09-06 00:00:00",
      // "followupNotes": "Discussed pricing and next steps",
      // "nextFollowupDate": "2025-09-10 00:00:00",
      // "nextFollowupTime": "14:00:00",
      "offeringList": [
          {
              "offeringId": 4441,
              "offeringType": "SERVICE"
          },
          {
              "offeringId": 4,
              "offeringType": "PRODUCT"
          }
      ]
  }
}

settings {
  encodeUrl: true
}
