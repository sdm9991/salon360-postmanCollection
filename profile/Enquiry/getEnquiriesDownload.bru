meta {
  name: getEnquiriesDownload
  type: http
  seq: 5
}

post {
  url: {{ip}}/profile/enquiry/getEnquiriesDownload
  body: json
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
  {
    "fromDate": "2025-09-01", // enquiry form fdate
    "toDate": "2026-09-04",
  //   "followupFromDate": "2025-09-07", //followup date filter
  //   "followupToDate": "2025-09-08",
    "leadStatus": null,
    "assignedEmpId": null,
    "gender": null,
    "enquiryType": null,
    "searchText": null,
    "sourceId": null,
    "format": "pdf" // pdf or excel
  
    // NOTE : Filter value should be the same as the getEnquiries API( ehat ever the user chooses), only addition is to have the formaat
  }
}

settings {
  encodeUrl: true
}
