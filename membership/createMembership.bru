meta {
  name: createMembership
  type: http
  seq: 1
}

post {
  url: {{ip}}/membership/create
  body: json
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
  {
  "membershipName" : "testLast",
  "defaultDiscountValue" : 15,
  "bsMembershipPriceMapDTO" : {
      "validityInDays" : 100,
      "membershipCost" : 100,
      "gstGroupApplicable" : true,
      "sgstApplicable" : false,
      "cgstApplicable" : false
  },
  "offerings" : [ 
      {
          "membershipDiscountType" : "VALUE",
          "membershipOfferingType" : "SERVICE",
          "offeringId" : 1510,
          "discountValue" : 6,
          "active" : true
      }, 
      {
          "membershipDiscountType" : "VALUE",
          "membershipOfferingType" : "SERVICE",
          "offeringId" : 1515,
          "discountValue" : 6,
          "active" : true
      }
  ]
  }
}

settings {
  encodeUrl: true
}
