        "categoryId": "1",
        "subCategoryId": "1",
        "price": 120,
        "cost": 120,
        "taxType": "",
        "taxGroup": "",
        "measurement": 20,
        "unit": "",
        "quantity": 10,
        "skuNumber": "SKU11",
        "brandName": "dkdkdkd",
        "date": null,
        "expiryDate": null,
        "lotNumber": "",
        "hsnCode": ""
    }
  '''
  file: @file(/Users/durgesh/Downloads/image_upload_ic.svg)
}

settings {
  encodeUrl: true
}
