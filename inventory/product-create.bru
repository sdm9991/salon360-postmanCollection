meta {
  name: product/create
  type: http
  seq: 6
}

post {
  url: {{ip}}/inventory/product/create
  body: multipartForm
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:multipart-form {
  body: '''
    {
    
        "typeId": "1",
        "description": "",
