  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
  {
      "categoryId":3,
      "categoryName": "Nail Care updated",
      "description": "Devices for nail  care"
  }
}

settings {
  encodeUrl: true
}
