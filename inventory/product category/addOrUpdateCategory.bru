meta {
  name: addOrUpdateCategory
  type: http
  seq: 1
}

post {
  url: {{ip}}/inventory/product/addOrUpdateCategory
  body: json
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
