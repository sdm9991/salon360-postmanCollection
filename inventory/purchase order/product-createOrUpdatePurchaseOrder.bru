meta {
  name: product/createOrUpdatePurchaseOrder
  type: http
  seq: 1
}

post {
  url: {{ip}}/inventory/product/createOrUpdatePurchaseOrder
  body: json
  auth: inherit
}

headers {
  x-bs-session-id: {{x-bs-session-id}}
  x-bs-platform: Android
  x-bs-app-version: 4.2.1
  Content-Type: application/json
}

body:json {
  {
      "purchaseOrderId": 8,
      "status": "RECEIVED",
  
      "products": [
          {
              "productId": 5,
              "quantity": 10,
              "costPrice": 1199.99
          },
          {
              "productId": 6,
              "quantity": 5,
              "costPrice": 1149.99
          }
      ],
      "supplierId": 3,
      "quantity": 10,
      "costPrice": 99.99
  }
}

settings {
  encodeUrl: true
}
